# ============================================================
# JuryAI environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file — it is git-ignored.
# ============================================================

# --- Supabase -------------------------------------------------
# Create a free project at https://supabase.com
# Then go to: Project Settings -> API  (or the "Connect" tab)
#
# SUPABASE_URL:
#   The "Project URL", e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# SUPABASE_ANON_KEY:
#   The "anon public" key. Safe to expose to the browser/frontend.
SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY:
#   The "service_role" key. SERVER-SIDE ONLY — never expose to the
#   frontend. Bypasses Row Level Security. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# SUPABASE_DB_PASSWORD:
#   The database password you set when creating the project.
#   Used for direct Postgres connections (psql / SQL editor).
#   Can be reset under Project Settings -> Database.
SUPABASE_DB_PASSWORD=

SUPABASE_STORAGE_BUCKET=submissions

# --- Groq ------------------------------------------------------
# Sign up at https://console.groq.com and create an API key.
# Used by the scoring agents for LLM inference (free tier).
GROQ_API_KEY=

# --- Image understanding (v0.3.5) -------------------------------
# GROQ_VISION_MODEL:
#   The Groq model used to describe diagram-like images.
#   qwen/qwen3.6-27b is verified vision-capable on the free tier
#   (llama-4-scout is NOT available on free accounts).
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# --- Image understanding (v0.3.6): optional Gemini describer -----
# VISION_PROVIDER:
#   Which provider describes images: "groq" (default, qwen via the
#   GROQ_VISION_MODEL above) or "gemini" (Google AI Studio). Scoring
#   and all text stages always use Groq regardless of this setting.
VISION_PROVIDER=groq

# GEMINI_API_KEY:
#   Only needed when VISION_PROVIDER=gemini. Create a free key at
#   https://aistudio.google.com/apikey (no credit card required).
GEMINI_API_KEY=

# GEMINI_VISION_MODEL:
#   The Gemini model used to describe diagram-like images when
#   VISION_PROVIDER=gemini. All Gemini models are multimodal.
GEMINI_VISION_MODEL=gemini-2.5-flash

# CLIP_MODEL / CLIP_PRETRAINED:
#   Local CLIP zero-shot classifier (open_clip). Weights (~350 MB)
#   download once, on first use, and are cached locally.
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=openai

# IMAGE_CLASSIFY_THRESHOLD:
#   CLIP confidence at/above which the top label is trusted for
#   routing; below it, images are described AND flagged for review.
IMAGE_CLASSIFY_THRESHOLD=0.7

# PHASH_HAMMING_THRESHOLD:
#   Hamming distance at/below which two perceptual hashes count as
#   the same image (dedupe + cross-submission cache near-match).
PHASH_HAMMING_THRESHOLD=8

# MIN_IMAGE_DIMENSION:
#   Images smaller than this (px) on either side are skipped as icons.
MIN_IMAGE_DIMENSION=64

# --- Frontend --------------------------------------------------
# The origin(s) the frontend is served from, so the backend can allow
# cross-origin requests (CORS). Comma-separated for multiple origins.
# In dev, the Next.js frontend runs on http://localhost:3000.
FRONTEND_URL=http://localhost:3000
